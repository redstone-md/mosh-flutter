@@ -0,0 +1,79 @@
+//! AVFoundation can pad each plane's rows; camera active formats do not describe it.
+
+/// One plane of a locked biplanar pixel buffer, its rows `stride` bytes apart.
+pub(crate) struct Plane<'a> {
+    pub bytes: &'a [u8],
+    pub stride: usize,
+}
+
+/// A 4:2:0 biplanar frame as packed NV12: its luma rows, then its interleaved
+/// chroma rows, each `width` bytes without row padding.
+pub(crate) fn pack(luma: Plane<'_>, chroma: Plane<'_>, width: usize, height: usize) -> Option<Vec<u8>> {
+    let pixels = width.checked_mul(height)?;
+    if width == 0
+        || height == 0
+        || width % 2 != 0
+        || height % 2 != 0
+        || width > 1920
+        || height > 1920
+        || pixels > 1920 * 1080
+    {
+        return None;
+    }
+    let mut output = Vec::with_capacity(pixels / 2 * 3);
+    for (plane, rows) in [(luma, height), (chroma, height / 2)] {
+        // The last row may end with its pixels instead of its padding.
+        let needed = (rows - 1).checked_mul(plane.stride)?.checked_add(width)?;
+        if plane.stride < width || plane.bytes.len() < needed {
+            return None;
+        }
+        for row in plane.bytes.chunks(plane.stride).take(rows) {
+            output.extend_from_slice(&row[..width]);
+        }
+    }
+    Some(output)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn plane(bytes: &[u8], stride: usize) -> Plane<'_> {
+        Plane { bytes, stride }
+    }
+
+    #[test]
+    fn keeps_both_planes_in_order_and_skips_row_padding() {
+        // 4x2: two luma rows and one chroma row, each padded to six bytes.
+        let luma = [1, 2, 3, 4, 99, 99, 5, 6, 7, 8, 99, 99];
+        let chroma = [10, 20, 30, 40, 88, 88];
+        assert_eq!(
+            pack(plane(&luma, 6), plane(&chroma, 6), 4, 2),
+            Some(vec![1, 2, 3, 4, 5, 6, 7, 8, 10, 20, 30, 40])
+        );
+        // The last row of a plane may stop at its last pixel.
+        assert_eq!(
+            pack(plane(&luma[..10], 6), plane(&chroma[..4], 6), 4, 2),
+            Some(vec![1, 2, 3, 4, 5, 6, 7, 8, 10, 20, 30, 40])
+        );
+    }
+
+    #[test]
+    fn rejects_short_planes_narrow_strides_and_odd_or_oversized_frames() {
+        let bytes = [0; 64];
+        for (luma, chroma, stride, width, height) in [
+            (9, 4, 6, 4, 2),
+            (10, 3, 6, 4, 2),
+            (64, 64, 3, 4, 2),
+            (64, 64, 6, 0, 2),
+            (64, 64, 6, 4, 0),
+            (64, 64, 6, 3, 2),
+            (64, 64, 6, 4, 3),
+            (64, 64, 6, usize::MAX, 2),
+            (64, 64, 1920, 1920, 1920),
+        ] {
+            let packed = pack(plane(&bytes[..luma], stride), plane(&bytes[..chroma], stride), width, height);
+            assert!(packed.is_none(), "{width}x{height} stride {stride}");
+        }
+    }
+}
