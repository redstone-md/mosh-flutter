@@ -0,0 +1,53 @@
+//! AVFoundation output can pad each row; camera active formats do not describe it.
+pub(crate) fn rgb(bytes: &[u8], width: usize, height: usize, stride: usize) -> Option<Vec<u8>> {
+    let row = width.checked_mul(4)?;
+    let pixels = width.checked_mul(height)?;
+    if width == 0
+        || height == 0
+        || width > 1920
+        || height > 1920
+        || pixels > 1920 * 1080
+        || stride < row
+        || bytes.len() < height.checked_mul(stride)?
+    {
+        return None;
+    }
+    let mut output = Vec::with_capacity(pixels.checked_mul(3)?);
+    for y in 0..height {
+        for bgra in bytes[y * stride..y * stride + row].chunks_exact(4) {
+            output.extend_from_slice(&[bgra[2], bgra[1], bgra[0]]);
+        }
+    }
+    Some(output)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preserves_actual_dimensions_color_order_and_skips_padding() {
+        let bytes = [
+            1, 2, 3, 255, 4, 5, 6, 255, 99, 99, 99, 99, 7, 8, 9, 255, 10, 11, 12, 255, 88, 88, 88,
+            88,
+        ];
+        assert_eq!(
+            rgb(&bytes, 2, 2, 12),
+            Some(vec![3, 2, 1, 6, 5, 4, 9, 8, 7, 12, 11, 10])
+        );
+    }
+
+    #[test]
+    fn rejects_invalid_stride_truncation_overflow_and_oversized_frames() {
+        for (width, height, stride) in [
+            (0, 1, 4),
+            (1, 0, 4),
+            (2, 1, 7),
+            (2, 2, 12),
+            (usize::MAX, 1, 4),
+            (1920, 1920, 7680),
+        ] {
+            assert!(rgb(&[0; 16], width, height, stride).is_none());
+        }
+    }
+}
