+//! A network the embedder carries itself. A factory created with
+//! [`crate::peer_connection_factory::PeerConnectionFactory::with_virtual_network`]
+//! gathers one host candidate per socket on `ip`, sends every packet through
+//! the given closure and never opens an OS socket or resolves a hostname.
+
+use std::net::{Ipv4Addr, SocketAddrV4};
+
+use cxx::SharedPtr;
+use webrtc_sys::virtual_network::{ffi, VirtualNetworkSender};
+
+#[derive(Clone)]
+pub struct VirtualNetwork {
+    pub(crate) sys_handle: SharedPtr<ffi::VirtualNetwork>,
+}
+
+impl VirtualNetwork {
+    /// `send` runs on the network thread with the local port, the
+    /// destination and the payload. Returning false reports a drop.
+    pub fn new(
+        ip: Ipv4Addr,
+        send: impl Fn(u16, SocketAddrV4, &[u8]) -> bool + Send + Sync + 'static,
+    ) -> Self {
+        let sender = VirtualNetworkSender::new(Box::new(move |port, ip, remote_port, data| {
+            send(port, SocketAddrV4::new(Ipv4Addr::from(ip), remote_port), data)
+        }));
+        Self { sys_handle: ffi::create_virtual_network(u32::from(ip), sender) }
+    }
+
+    /// Delivers a packet from `from` to the socket bound on `local_port`.
+    pub fn receive(&self, local_port: u16, from: SocketAddrV4, data: &[u8]) {
+        self.sys_handle.receive(local_port, u32::from(*from.ip()), from.port(), data);
+    }
+}
