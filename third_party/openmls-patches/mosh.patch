+thread_local! {
+    static VALIDATION_TIME: std::cell::Cell<Option<u64>> = const { std::cell::Cell::new(None) };
+}
+
+struct ValidationTimeGuard(Option<u64>);
+
+impl Drop for ValidationTimeGuard {
+    fn drop(&mut self) {
+        VALIDATION_TIME.with(|time| time.set(self.0));
+    }
+}
+
 impl Lifetime {
+    /// Run synchronous historical validation at a Unix timestamp supplied by
+    /// the application. The application must authenticate the retained commit
+    /// and admission evidence before selecting its historical validation time.
+    /// This affects lifetime validation only, is local to the calling thread,
+    /// and restores the previous policy on return or panic.
+    pub fn with_validation_time<T>(unix_seconds: u64, validate: impl FnOnce() -> T) -> T {
+        let previous = VALIDATION_TIME.with(|time| time.replace(Some(unix_seconds)));
+        let _guard = ValidationTimeGuard(previous);
+        validate()
+    }
+
