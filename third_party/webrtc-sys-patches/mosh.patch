+//! A virtual UDP network for a peer connection factory. The embedder
+//! carries the packets; nothing touches an OS socket.
+
+use crate::impl_thread_safety;
+
+#[cxx::bridge(namespace = "livekit_ffi")]
+pub mod ffi {
+    unsafe extern "C++" {
+        include!("livekit/virtual_network.h");
+
+        type VirtualNetwork;
+
+        fn create_virtual_network(
+            ipv4: u32,
+            sender: Box<VirtualNetworkSender>,
+        ) -> SharedPtr<VirtualNetwork>;
+
+        fn receive(
+            self: &VirtualNetwork,
+            local_port: u16,
+            remote_ipv4: u32,
+            remote_port: u16,
+            data: &[u8],
+        );
+    }
+
+    extern "Rust" {
+        type VirtualNetworkSender;
+
+        fn send(
+            self: &VirtualNetworkSender,
+            local_port: u16,
+            remote_ipv4: u32,
+            remote_port: u16,
+            data: &[u8],
+        ) -> bool;
+    }
+}
+
+impl_thread_safety!(ffi::VirtualNetwork, Send + Sync);
+
+/// Called on the network thread for every outgoing packet. Returns false
+/// when the packet was dropped.
+pub type SendPacket = dyn Fn(u16, u32, u16, &[u8]) -> bool + Send + Sync;
+
+pub struct VirtualNetworkSender(Box<SendPacket>);
+
+impl VirtualNetworkSender {
+    pub fn new(send: Box<SendPacket>) -> Box<Self> {
+        Box::new(Self(send))
+    }
+
+    fn send(&self, local_port: u16, remote_ipv4: u32, remote_port: u16, data: &[u8]) -> bool {
+        (self.0)(local_port, remote_ipv4, remote_port, data)
+    }
+}
