+// A network with one virtual IPv4 interface and UDP sockets only. Packets
+// a peer connection sends leave through a Rust sender, and the embedder
+// delivers incoming packets with receive(); no OS socket, DNS lookup or
+// interface enumeration is involved.
+
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+
+#include "api/packet_socket_factory.h"
+#include "rtc_base/buffer.h"
+#include "rtc_base/ip_address.h"
+#include "rtc_base/network.h"
+#include "rtc_base/socket_address.h"
+#include "rtc_base/thread.h"
+#include "rust/cxx.h"
+
+namespace livekit_ffi {
+class VirtualNetwork;
+class VirtualNetworkSender;
+}  // namespace livekit_ffi
+#include "webrtc-sys/src/virtual_network.rs.h"
+
+namespace livekit_ffi {
+
+class VirtualSocket;
+
+class VirtualNetwork : public std::enable_shared_from_this<VirtualNetwork> {
+ public:
+  VirtualNetwork(uint32_t ipv4, rust::Box<VirtualNetworkSender> sender);
+
+  // Delivers a packet addressed to `local_port` from the peer's address.
+  // Callable from any thread; delivery happens on the network thread.
+  void receive(uint16_t local_port,
+               uint32_t remote_ipv4,
+               uint16_t remote_port,
+               rust::Slice<const uint8_t> data) const;
+
+  // Binds the network to one factory's network thread. Returns false when
+  // another factory already owns it.
+  bool attach(webrtc::Thread* thread);
+  // Called when that factory goes away; later receive() calls are dropped.
+  void detach();
+  std::unique_ptr<webrtc::PacketSocketFactory> socket_factory();
+  std::unique_ptr<webrtc::NetworkManager> network_manager() const;
+
+  const webrtc::IPAddress& ip() const { return ip_; }
+
+  // Network-thread socket registry.
+  uint16_t bind(VirtualSocket* socket, uint16_t min_port, uint16_t max_port);
+  void unbind(uint16_t port);
+  bool send(uint16_t local_port,
+            const webrtc::SocketAddress& to,
+            const void* data,
+            size_t size) const;
+
+ private:
+  void deliver(uint16_t local_port,
+               const webrtc::SocketAddress& from,
+               webrtc::Buffer packet);
+
+  webrtc::IPAddress ip_;
+  rust::Box<VirtualNetworkSender> sender_;
+  // Guards thread_: receive() may run on any thread while the factory ends.
+  mutable std::mutex thread_lock_;
+  webrtc::Thread* thread_ = nullptr;
+  std::map<uint16_t, VirtualSocket*> sockets_;
+};
+
+std::shared_ptr<VirtualNetwork> create_virtual_network(
+    uint32_t ipv4,
+    rust::Box<VirtualNetworkSender> sender);
+
+}  // namespace livekit_ffi
