+// One UDP port on the virtual interface. Lives on the network thread.
+class VirtualSocket : public webrtc::AsyncPacketSocket {
+ public:
+  VirtualSocket(std::shared_ptr<VirtualNetwork> network,
+                webrtc::SocketAddress local)
+      : network_(std::move(network)), local_(std::move(local)) {}
+
+  ~VirtualSocket() override { network_->unbind(local_.port()); }
+
+  void set_port(uint16_t port) { local_.SetPort(port); }
+
+  webrtc::SocketAddress GetLocalAddress() const override { return local_; }
+  webrtc::SocketAddress GetRemoteAddress() const override { return {}; }
+
+  int Send(const void*, size_t, const webrtc::AsyncSocketPacketOptions&)
+      override {
+    error_ = ENOTCONN;
+    return -1;
+  }
+
+  int SendTo(const void* data,
+             size_t size,
+             const webrtc::SocketAddress& to,
+             const webrtc::AsyncSocketPacketOptions& options) override {
+    if (state_ == STATE_CLOSED) {
+      error_ = EBADF;
+      return -1;
+    }
+    // A full queue drops the packet like a congested link would; WebRTC's
+    // own congestion control reacts to the loss.
+    network_->send(local_.port(), to, data, size);
+    webrtc::SentPacketInfo sent(options.packet_id, webrtc::TimeMillis(),
+                                options.info_signaled_after_sent);
+    NotifySentPacket(this, sent);
+    return static_cast<int>(size);
+  }
+
+  int Close() override {
+    state_ = STATE_CLOSED;
+    return 0;
+  }
+
+  State GetState() const override { return state_; }
+  int GetOption(webrtc::Socket::Option, int*) override { return -1; }
+  int SetOption(webrtc::Socket::Option, int) override { return 0; }
+  int GetError() const override { return error_; }
+  void SetError(int error) override { error_ = error; }
+
+  void deliver(const webrtc::SocketAddress& from,
+               const webrtc::Buffer& packet) {
+    if (state_ == STATE_CLOSED) {
+      return;
+    }
+    NotifyPacketReceived(webrtc::ReceivedIpPacket(
+        packet, from, webrtc::Timestamp::Micros(webrtc::TimeMicros())));
+  }
+
+ private:
+  std::shared_ptr<VirtualNetwork> network_;
+  webrtc::SocketAddress local_;
+  State state_ = STATE_BOUND;
+  int error_ = 0;
+};
+
+namespace {
+
+// Hostname candidates are never produced on the virtual network; any
+// lookup fails rather than reaching the system resolver.
+class NoDnsResolver : public webrtc::AsyncDnsResolverInterface,
+                      public webrtc::AsyncDnsResolverResult {
+ public:
+  void Start(const webrtc::SocketAddress&,
+             absl::AnyInvocable<void()> callback) override {
+    fail(std::move(callback));
+  }
+  void Start(const webrtc::SocketAddress&,
+             int,
+             absl::AnyInvocable<void()> callback) override {
+    fail(std::move(callback));
+  }
+  const webrtc::AsyncDnsResolverResult& result() const override {
+    return *this;
+  }
+  bool GetResolvedAddress(int, webrtc::SocketAddress*) const override {
+    return false;
+  }
+  int GetError() const override { return EAI_FAIL_CODE; }
+
+ private:
+  static constexpr int EAI_FAIL_CODE = -4;
+
+  void fail(absl::AnyInvocable<void()> callback) {
+    webrtc::Thread::Current()->PostTask(
+        webrtc::SafeTask(safety_.flag(), std::move(callback)));
+  }
+
+  webrtc::ScopedTaskSafety safety_;
+};
+
+class VirtualSocketFactory : public webrtc::PacketSocketFactory {
+ public:
+  explicit VirtualSocketFactory(std::shared_ptr<VirtualNetwork> network)
+      : network_(std::move(network)) {}
+
+  std::unique_ptr<webrtc::AsyncPacketSocket> CreateUdpSocket(
+      const webrtc::Environment&,
+      const webrtc::SocketAddress& address,
+      uint16_t min_port,
+      uint16_t max_port) override {
+    if (!address.IsAnyIP() && address.ipaddr() != network_->ip()) {
+      return nullptr;
+    }
+    auto socket = std::make_unique<VirtualSocket>(
+        network_, webrtc::SocketAddress(network_->ip(), 0));
+    uint16_t port = network_->bind(socket.get(), min_port, max_port);
+    if (port == 0) {
+      return nullptr;
+    }
+    socket->set_port(port);
+    return socket;
+  }
+
+  std::unique_ptr<webrtc::AsyncListenSocket> CreateServerTcpSocket(
+      const webrtc::Environment&,
+      const webrtc::SocketAddress&,
+      uint16_t,
+      uint16_t,
+      int) override {
+    return nullptr;
+  }
+
+  std::unique_ptr<webrtc::AsyncPacketSocket> CreateClientTcpSocket(
+      const webrtc::Environment&,
+      const webrtc::SocketAddress&,
+      const webrtc::SocketAddress&,
+      const webrtc::PacketSocketTcpOptions&) override {
+    return nullptr;
+  }
+
+  std::unique_ptr<webrtc::AsyncDnsResolverInterface> CreateAsyncDnsResolver()
+      override {
+    return std::make_unique<NoDnsResolver>();
+  }
+
+ private:
+  std::shared_ptr<VirtualNetwork> network_;
+};
+
+// Reports exactly the virtual interface, so ICE gathers one host candidate
+// per socket and never enumerates the machine's adapters.
+class VirtualNetworkManager : public webrtc::NetworkManagerBase {
+ public:
+  explicit VirtualNetworkManager(webrtc::IPAddress ip) : ip_(ip) {}
+
+  void StartUpdating() override {
+    if (!listed_) {
+      listed_ = true;
+      auto network = std::make_unique<webrtc::Network>(
+          "mosh", "Mosh", webrtc::TruncateIP(ip_, 24), 24,
+          webrtc::ADAPTER_TYPE_ETHERNET);
+      network->AddIP(ip_);
+      std::vector<std::unique_ptr<webrtc::Network>> list;
+      list.push_back(std::move(network));
+      bool changed = false;
+      MergeNetworkList(std::move(list), &changed);
+      set_enumeration_permission(ENUMERATION_ALLOWED);
+      set_default_local_addresses(ip_, webrtc::IPAddress());
+    }
+    webrtc::Thread::Current()->PostTask(
+        webrtc::SafeTask(safety_.flag(), [this] { NotifyNetworksChanged(); }));
+  }
+
+  void StopUpdating() override {}
+
+ private:
+  webrtc::IPAddress ip_;
+  bool listed_ = false;
+  webrtc::ScopedTaskSafety safety_;
+};
+
+constexpr uint16_t kFirstEphemeralPort = 49152;
+
+}  // namespace
+
+VirtualNetwork::VirtualNetwork(uint32_t ipv4,
+                               rust::Box<VirtualNetworkSender> sender)
+    : ip_(ipv4), sender_(std::move(sender)) {}
+
+void VirtualNetwork::attach(webrtc::Thread* thread) {
+  thread_ = thread;
+}
+
+std::unique_ptr<webrtc::PacketSocketFactory> VirtualNetwork::socket_factory() {
+  return std::make_unique<VirtualSocketFactory>(shared_from_this());
+}
+
+std::unique_ptr<webrtc::NetworkManager> VirtualNetwork::network_manager()
+    const {
+  return std::make_unique<VirtualNetworkManager>(ip_);
+}
+
+uint16_t VirtualNetwork::bind(VirtualSocket* socket,
+                              uint16_t min_port,
+                              uint16_t max_port) {
+  if (min_port == 0 && max_port == 0) {
+    min_port = kFirstEphemeralPort;
+    max_port = UINT16_MAX;
+  }
+  for (uint32_t port = min_port; port <= max_port; ++port) {
+    if (sockets_.emplace(static_cast<uint16_t>(port), socket).second) {
+      return static_cast<uint16_t>(port);
+    }
+  }
+  return 0;
+}
+
+void VirtualNetwork::unbind(uint16_t port) {
+  sockets_.erase(port);
+}
+
+bool VirtualNetwork::send(uint16_t local_port,
+                          const webrtc::SocketAddress& to,
+                          const void* data,
+                          size_t size) const {
+  if (to.family() != AF_INET) {
+    return false;
+  }
+  rust::Slice<const uint8_t> bytes(static_cast<const uint8_t*>(data), size);
+  return sender_->send(local_port, to.ipaddr().v4AddressAsHostOrderInteger(),
+                       to.port(), bytes);
+}
+
+void VirtualNetwork::receive(uint16_t local_port,
+                             uint32_t remote_ipv4,
+                             uint16_t remote_port,
+                             rust::Slice<const uint8_t> data) const {
+  if (thread_ == nullptr) {
+    return;
+  }
+  std::weak_ptr<VirtualNetwork> weak =
+      std::const_pointer_cast<VirtualNetwork>(shared_from_this());
+  webrtc::SocketAddress from(webrtc::IPAddress(remote_ipv4), remote_port);
+  webrtc::Buffer packet(data.data(), data.size());
+  thread_->PostTask([weak, local_port, from, packet = std::move(packet)]() mutable {
+    if (auto network = weak.lock()) {
+      network->deliver(local_port, from, std::move(packet));
+    }
+  });
+}
+
+void VirtualNetwork::deliver(uint16_t local_port,
+                             const webrtc::SocketAddress& from,
+                             webrtc::Buffer packet) {
+  auto socket = sockets_.find(local_port);
+  if (socket != sockets_.end()) {
+    socket->second->deliver(from, packet);
+  }
+}
+
+std::shared_ptr<VirtualNetwork> create_virtual_network(
+    uint32_t ipv4,
+    rust::Box<VirtualNetworkSender> sender) {
+  return std::make_shared<VirtualNetwork>(ipv4, std::move(sender));
+}
